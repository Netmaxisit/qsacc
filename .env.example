# Copy to .env and fill in values. .env is gitignored — never commit it.
#
# Local dev:  npm run dev  (reads .env automatically)
# Production:  npm run cf:secrets  (uploads vars from .env to Cloudflare Worker secrets)
#              Requires CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN in your shell.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Public canonical URL (sitemap, Open Graph, JSON-LD). Use your live domain.
NEXT_PUBLIC_SITE_URL=https://qsaccountants.co.uk

# ntfy lead push (self-hosted — publish token only, never commit real values)
NTFY_BASE_URL=https://ntfy.netmaxiscloud.dpdns.org
NTFY_TOPIC=qsacc-leads
NTFY_TOKEN=

# Admin dashboard (local seed only — never upload as Worker secret)
# Run: npm run admin:seed  (creates user in remote D1)
ADMIN_EMAIL=admin@qsaccountants.co.uk
ADMIN_PASSWORD=
ADMIN_NAME=Quicksolve Admin
